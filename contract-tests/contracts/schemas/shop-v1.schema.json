    "DeliveryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeId",
        "deliveryId",
        "deliverySequence",
        "state",
        "receivedAt",
        "attemptCount",
        "items"
      ],
      "properties": {
        "storeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "deliveryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "deliverySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "WAITING_PRICING",
            "POSTED",
            "REJECTED"
          ]
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "postedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextAttemptAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "lastError": {
          "$ref": "#/$defs/DeliveryError"
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/DeliveryViewLine"
          }
        },
        "rejectedPayload": {
          "description": "Original parsed payload for diagnostics; it may intentionally violate DeliveryPayload.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "POSTED"
              }
            }
          },
          "then": {
            "required": [
              "postedAt"
            ],
            "properties": {
              "items": {
                "items": {
                  "required": [
                    "markupRate",
                    "tariffRuleId",
                    "tariffVersion",
                    "salePrice"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "WAITING_PRICING"
              }
            }
          },
          "then": {
            "required": [
              "nextAttemptAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "WAITING_PRICING",
                  "POSTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "lastError",
              "rejectedPayload"
            ]
          }
        }
      ]
    },
