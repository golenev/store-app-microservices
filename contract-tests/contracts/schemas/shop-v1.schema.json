          "pattern": "^(0|[1-9][0-9]{0,35})\\.[0-9]{2}$",
          "not": {
            "const": "0.00"
          }
        }
      }
    },
    "CartResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeId",
        "cartId",
        "version",
        "state",
        "items",
        "totalAmount",
        "currency"
      ],
      "properties": {
        "storeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "cartId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "OPEN",
            "SUBMITTED"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/CartLine"
          }
        },
        "totalAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,35})\\.[0-9]{2}$"
        },
        "currency": {
          "const": "RUB"
        },
        "submissionId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "SUBMITTED"
              }
            }
          },
          "then": {
            "required": [
              "submissionId"
            ]
          }
        }
      ]
    },
    "PutCartItemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "expectedCartVersion"
      ],
      "properties": {
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expectedCartVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "SubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCartVersion"
      ],
      "properties": {
        "expectedCartVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "SubmissionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeId",
        "submissionId",
        "cartId",
        "eventId",
        "publicationStatus",
        "acceptedAt"
      ],
      "properties": {
        "storeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "submissionId": {
          "type": "string",
          "format": "uuid"
        },
        "cartId": {
          "type": "string",
          "format": "uuid"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "publicationStatus": {
          "enum": [
            "PENDING",
            "PUBLISHED"
          ]
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publicationStatus": {
                "const": "PUBLISHED"
              }
            }
          },
          "then": {
            "required": [
              "publishedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "publicationStatus": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "publishedAt"
              ]
            }
          }
        }
      ]
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "status",
        "code",
        "message",
        "path"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "INSUFFICIENT_STOCK",
            "CART_VERSION_CONFLICT",
            "CART_ALREADY_SUBMITTED",
            "IDEMPOTENCY_KEY_REUSED",
            "TARIFF_NOT_FOUND",
            "TARIFF_AMBIGUOUS",
            "DEPENDENCY_UNAVAILABLE",
            "DELIVERY_CONTENT_CONFLICT",
            "DELIVERY_NOT_WAITING_PRICING",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "details": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/DeliveryReceived"
    },
    {
      "$ref": "#/$defs/GoodsPosted"
    },
    {
      "$ref": "#/$defs/OrderSubmitted"
    }
  ]
}
