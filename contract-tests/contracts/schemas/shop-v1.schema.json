    "TariffRuleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productType",
        "cityId",
        "currency",
        "lowerBound",
        "upperBound",
        "markupRate"
      ],
      "properties": {
        "productType": {
          "enum": [
            "FOOD",
            "NON_FOOD"
          ]
        },
        "cityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "currency": {
          "const": "RUB"
        },
        "lowerBound": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,25})\\.[0-9]{2}$"
        },
        "upperBound": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,25})\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "markupRate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2})\\.[0-9]{1,6}$"
        }
