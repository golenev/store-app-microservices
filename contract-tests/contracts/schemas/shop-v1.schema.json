          "const": "RUB"
        },
        "markupRate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2})\\.[0-9]{1,6}$"
        },
        "tariffRuleId": {
          "type": "string",
          "format": "uuid"
        },
        "tariffVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
