{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Educational shop contracts v1",
  "description": "Target wire contracts; availability is tracked in README. Definitions describe structure, not transactional guarantees.",
  "$defs": {
    "DeliveryLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "productId",
        "productType",
        "shortName",
        "description",
        "quantity",
        "purchasePrice",
        "currency"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "productType": {
          "enum": [
            "FOOD",
            "NON_FOOD"
          ]
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "purchasePrice": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,25})\\.[0-9]{2}$",
          "not": {
            "const": "0.00"
          }
        },
        "currency": {
          "const": "RUB"
        }
      }
    },
    "DeliveryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveryId",
        "items"
      ],
      "properties": {
        "deliveryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/DeliveryLine"
          }
        }
      }
    },
