{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Учебный магазин — целевые HTTP-контракты",
    "version": "1.0.0",
    "description": "Спецификация задачи 1, endpoints ещё не реализованы. Каждый сервис обслуживает операции только своего tag. Порты будут определены в задаче 2."
  },
  "tags": [
    {
      "name": "TARIFFS"
    },
    {
      "name": "WAREHOUSE"
    },
    {
      "name": "STORE"
    }
  ],
  "paths": {
    "/tariffs/quote": {
      "get": {
        "tags": [
          "TARIFFS"
        ],
        "operationId": "quoteTariff",
        "parameters": [
          {
            "name": "productType",
            "in": "query",
            "required": true,
            "description": "Параметр quote.",
            "schema": {
              "enum": [
                "FOOD",
                "NON_FOOD"
              ]
            }
          },
          {
            "name": "purchasePrice",
            "in": "query",
            "required": true,
            "description": "Параметр quote.",
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,25})\\.[0-9]{2}$",
              "not": {
                "const": "0.00"
              }
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "description": "Параметр quote.",
            "schema": {
              "const": "RUB"
            }
          },
          {
            "name": "cityId",
            "in": "query",
            "required": true,
            "description": "Параметр quote.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Коэффициент и версия выбранного правила.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/QuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "TARIFF_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "TARIFF_AMBIGUOUS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR без stack trace и секретов.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE. Неопределённый результат изменяющей операции восстанавливается прежним ключом и параметрами.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/shop-v1.schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
